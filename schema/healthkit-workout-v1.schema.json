{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nirvanasangsara-AI/nrc-volt-sync/schema/healthkit-workout-v1.schema.json",
  "title": "NRC Volt Sync HealthKit Workout Outbox v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "id",
    "activity_type",
    "name",
    "start_date",
    "end_date",
    "duration_s",
    "distance_m",
    "timezone_offset_s",
    "route",
    "samples"
  ],
  "properties": {
    "schema": { "const": "io.github.nrcvoltsync.healthkit.workout" },
    "schema_version": { "const": 1 },
    "id": { "type": "string", "format": "uuid" },
    "activity_type": { "const": "running" },
    "name": { "type": "string", "maxLength": 200 },
    "start_date": { "type": "string", "format": "date-time" },
    "end_date": { "type": "string", "format": "date-time" },
    "duration_s": { "type": "number", "minimum": 1 },
    "distance_m": { "type": "number", "minimum": 0, "maximum": 1000000 },
    "calories": { "type": ["number", "null"], "minimum": 0, "maximum": 100000 },
    "timezone_offset_s": { "type": "integer", "minimum": -86400, "maximum": 86400 },
    "device_name": { "type": ["string", "null"], "maxLength": 200 },
    "source_bundle_id": { "type": ["string", "null"], "maxLength": 300 },
    "route": {
      "type": "array",
      "items": { "$ref": "#/$defs/routePoint" }
    },
    "samples": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "heart_rate": { "$ref": "#/$defs/timedArray" },
        "distance": { "$ref": "#/$defs/timedArray" },
        "running_power": { "$ref": "#/$defs/timedArray" },
        "running_speed": { "$ref": "#/$defs/timedArray" },
        "stride_length": { "$ref": "#/$defs/timedArray" },
        "vertical_oscillation": { "$ref": "#/$defs/timedArray" },
        "ground_contact_time": { "$ref": "#/$defs/timedArray" }
      }
    }
  },
  "$defs": {
    "timedArray": {
      "type": "array",
      "items": { "$ref": "#/$defs/timedValue" }
    },
    "timedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset_s", "value"],
      "properties": {
        "offset_s": { "type": "number", "minimum": 0 },
        "value": { "type": "number" }
      }
    },
    "routePoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset_s", "latitude", "longitude"],
      "properties": {
        "offset_s": { "type": "number", "minimum": 0 },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "altitude_m": { "type": ["number", "null"], "minimum": -500, "maximum": 20000 },
        "speed_m_s": { "type": ["number", "null"], "minimum": -1, "maximum": 100 }
      }
    }
  }
}
